salario_bruto = float(input("Informe o salário bruto: "))
desc_inss = salario_bruto * (10/100)
desc_ir = salario_bruto * (11/100)

salario_liquido = salario_bruto - desc_inss - desc_ir

print(f"Salário Bruto:   R${salario_bruto:.2f}")
print(f"Desconto INSS:  -R${desc_inss:.2f}")
print(f"Desconto IR:    -R${desc_ir:.2f}")
print(f"Salário Líquido: R${salario_liquido:.2f}")